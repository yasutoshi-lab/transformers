{#- Llama 3 形式 + reasoning on/off。
    切り替え: system に "/think" または "/no_think" を書く（既定は on）。
    chat_template_kwargs の enable_thinking を渡した場合はそちらを優先する。
    思考は assistant 発話の先頭に <think>...</think> で書く。off のときは空の <think></think> を前置する。
    最後の assistant 発話以外に含まれる思考は取り除く。 -#}
{{- bos_token -}}
{%- if messages and messages[0]['role'] == 'system' -%}
    {%- set system_content = messages[0]['content'] -%}
    {%- set loop_messages = messages[1:] -%}
{%- else -%}
    {%- set system_content = '' -%}
    {%- set loop_messages = messages -%}
{%- endif -%}
{%- if enable_thinking is defined -%}
    {%- set thinking = enable_thinking -%}
{%- elif '/no_think' in system_content -%}
    {%- set thinking = false -%}
{%- else -%}
    {%- set thinking = true -%}
{%- endif -%}
{%- if system_content -%}
    {{- '<|start_header_id|>system<|end_header_id|>\n\n' + system_content | trim + '<|eot_id|>' -}}
{%- endif -%}
{%- for message in loop_messages -%}
    {%- set content = message['content'] | trim -%}
    {%- if message['role'] == 'assistant' and not loop.last and '</think>' in content -%}
        {%- set content = content.split('</think>')[-1] | trim -%}
    {%- endif -%}
    {{- '<|start_header_id|>' + message['role'] + '<|end_header_id|>\n\n' + content + '<|eot_id|>' -}}
{%- endfor -%}
{%- if add_generation_prompt -%}
    {{- '<|start_header_id|>assistant<|end_header_id|>\n\n' -}}
    {%- if not thinking -%}
        {{- '<think>\n\n</think>\n\n' -}}
    {%- endif -%}
{%- endif -%}
